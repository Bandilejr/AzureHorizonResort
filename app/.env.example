# app/.env.example — template for local environment variables.
# Copy to app/.env.local and fill in. `.env.local` is gitignored; do NOT put real
# values in this file, and do not commit `.env.local`.
#
#   cp .env.example .env.local
#
# `.env` itself is also gitignored now, but prefer `.env.local` for anything
# secret so the two never get confused.

# --- Firebase (web config) -------------------------------------------------
# Firebase web config is designed to be client-visible: it ships inside the
# bundle and is not a secret. What matters is that Firestore security rules
# restrict access, not that these values are hidden. Same values must be set
# in Netlify (Site settings → Environment variables) for the deployed build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Payments --------------------------------------------------------------
# Publishable test key. A pk_test_ / pk_live_ prefix key is safe to expose;
# the matching SECRET key must never reach the browser.
VITE_PAYSTACK_PUBLIC_KEY=

# --- QR signing secret -----------------------------------------------------
# SECRET. Signs collection passes and rotating member/voucher codes.
#
# This value is compiled into the client bundle, so it is readable by anyone who
# opens devtools. It provides integrity, not confidentiality. Treat a signed
# pass as "well-formed", not "verified origin", until signing moves server-side
# (Cloud Functions).
#
# It must match EXPO_PUBLIC_QR_SIGNING_SECRET in the mobile app. When unset,
# src/services/qr-signing.ts fails closed by design: collection scheduling and
# verification throw rather than fall back to a default.
VITE_QR_SIGNING_SECRET=

# --- Feature flags ---------------------------------------------------------
# Anything other than "false" leaves the app in demo mode.
VITE_DEMO_MODE=true
