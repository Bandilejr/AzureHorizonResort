{
  "name": "functions",
  "description": "Cloud Functions for Azure Horizon Resort",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "emulators": "firebase emulators:start --only functions,firestore,auth"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "private": true
}
