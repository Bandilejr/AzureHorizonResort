# Cloud Functions Environment Variables (Development/Free Tier)
# Copy this to .env and fill in your values

# JWT Private Key for Room Credentials (RS256)
# Generate with: openssl genrsa -out private_key.pem 2048
# Then copy the entire content including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD...
-----END PRIVATE KEY-----"

# HMAC Secret for Loyalty QR Rotation (32 bytes base64)
# Generate with: openssl rand -base64 32
LOYALTY_HMAC_SECRET="your-base64-encoded-32-byte-secret-here"

# HMAC Secret for Invitation QR Signing (32 bytes base64)
# Generate with: openssl rand -base64 32
INVITATION_SIGNING_KEY="your-base64-encoded-32-byte-secret-here"

# SendGrid API Key for Firebase Extensions Email
SENDGRID_API_KEY="SG.your-sendgrid-key-here"